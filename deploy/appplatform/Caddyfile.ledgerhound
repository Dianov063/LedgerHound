# Site blocks to append to the shared Caddyfile on 40.160.88.230
# (/opt/app-platform-prod/shared/caddy/Caddyfile). Additive only; see README.md.
#
# Security headers (CSP, X-Frame-Options, nosniff, Referrer-Policy) come from
# the app's middleware, as on Vercel; Caddy adds only HSTS (Vercel sent the
# same value). Caddy discards client-supplied X-Forwarded-For from untrusted
# peers and sets the real client IP, which the rate limiter keys on.

www.ledgerhound.vip {
    encode zstd gzip

    header Strict-Transport-Security "max-age=63072000"

    # Evidence uploads are capped at 10 MB by the app.
    request_body {
        max_size 12MB
    }

    reverse_proxy ledgerhound-web:3000
}

ledgerhound.vip {
    redir https://www.ledgerhound.vip{uri} permanent
}
