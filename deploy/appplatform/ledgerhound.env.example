# Runtime allowlist for /opt/ledgerhound/secrets/ledgerhound.env (root:root, 0600).
# Copy values from Vercel → Project → Settings → Environment Variables (Production).
# Do NOT bulk-export: VERCEL_*, TURBO_*, NX_* and VERCEL_OIDC_TOKEN are not used.
# Never commit the filled file.

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Storage (bucket in eu-central-1, objects KMS-encrypted)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_S3_BUCKET=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Admin + scheduled jobs (CRON_SECRET must equal the one in cron.env)
ADMIN_PASSWORD=
CRON_SECRET=

# Distributed rate limits (verified in use in production on 2026-10-17)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bot protection for payment-safety reports
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=

# Blockchain data
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
HELIUS_API_KEY=
TRONGRID_API_KEY=
CHAINABUSE_API_KEY=

# Blog agent (admin-only)
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=

LOG_LEVEL=info
