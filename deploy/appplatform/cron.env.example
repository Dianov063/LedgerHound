# /opt/ledgerhound/secrets/cron.env (root:root, 0600). The cron container gets
# only this; the value must equal CRON_SECRET in ledgerhound.env.
CRON_SECRET=
# Daily owner digest at 09:00 America/New_York: "on" schedules it (default off).
# The web container also needs OWNER_DIGEST_ENABLED=true and OWNER_DIGEST_TO to send.
OWNER_DIGEST_SCHEDULE=off
